# Yield AI — copy to .env.local and fill in what you have.
# Everything is optional: with nothing set, the app runs on the built-in demo data (8 farms,
# 60 days), local accounts and the offline agronomy engine. See README → "Environment variables".

# --- Supabase: data and accounts ----------------------------------------------------------
# Project URL and anon (publishable) key — Supabase dashboard → Project Settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only, never exposed to the browser. Used for data reads (after the app's own sign-in
# check), probe ingest and `npm run seed`. Without it, reads use the signed-in user's session.
SUPABASE_SERVICE_ROLE_KEY=
# true = show the built-in demo data even when Supabase is configured (sign-in still uses it).
USE_MOCK=false

# --- AI -------------------------------------------------------------------------------------
# The team's fine-tuned model: POST {farm_id, question, context, history} → {answer}.
AI_SERVICE_URL=
# Optional bearer token sent to the AI service.
AI_SERVICE_API_KEY=
# LLM fallback when AI_SERVICE_URL is unset or not answering (Claude via the Anthropic API).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Accounts -------------------------------------------------------------------------------
# Signs the session cookie of local accounts. Set it in production: openssl rand -base64 32
AUTH_SECRET=
# The account behind the "Try the demo account" button.
DEMO_EMAIL=demo@yield-ai.app
DEMO_PASSWORD=harvest-demo-2026

# --- Probes, live mode, weather ---------------------------------------------------------------
# Enables POST /api/readings for the probes (send it as "Authorization: Bearer <key>").
INGEST_API_KEY=
# Live mode feed — auto: simulate readings when no real ones arrive · on: always · off: never.
LIVE_SIMULATION=auto
# true = skip Open-Meteo; ET₀ is then estimated with FAO-56 Hargreaves from air temperature.
OPEN_METEO_DISABLED=false
