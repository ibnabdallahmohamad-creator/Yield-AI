# Yield AI — copy to .env.local and fill in what you have.
# Everything is optional: with nothing set, accounts and their farms live in the local .data/
# store, the chat answers from the offline agronomy engine, and the demo account shows 8 built-in
# demo farms. See README → "Environment variables".

# --- Supabase: accounts and their data ----------------------------------------------------
# Project URL and anon (publishable) key — Supabase dashboard → Project Settings → API.
# Apply supabase/migrations/0001_init.sql, 0002_accounts_devices.sql and 0003_device_ingest.sql first.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional, server only, never exposed to the browser. Creates accounts already confirmed, shares
# the weather cache between instances and enables bulk import. ESP32s don't need it.
SUPABASE_SERVICE_ROLE_KEY=
# true = keep accounts' data in the local store even when Supabase is configured.
USE_MOCK=false
# Folder of the local store and local accounts.
LOCAL_DATA_DIR=.data

# --- AI -------------------------------------------------------------------------------------
# The team's fine-tuned model: POST {farm_id, question, context, history} → {answer}.
AI_SERVICE_URL=
# Optional bearer token sent to the AI service.
AI_SERVICE_API_KEY=
# LLM fallback when AI_SERVICE_URL is unset or not answering (Claude via the Anthropic API).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Accounts -------------------------------------------------------------------------------
# Signs the session cookie of local accounts. Set it in production: openssl rand -base64 32
AUTH_SECRET=
# The shared demo account behind "Try the demo account".
DEMO_EMAIL=demo@yield-ai.app
DEMO_PASSWORD=harvest-demo-2026

# --- Probes, weather ------------------------------------------------------------------------
# ESP32s authenticate with their own device keys (Farms & devices). This key only enables bulk
# import into any farm through POST /api/readings.
INGEST_API_KEY=
# Enables GET /api/cron/weather (the 12-hourly forecast refresh) for an external scheduler.
CRON_SECRET=
# Demo account live feed — auto/on: simulate readings for the demo farms · off: never.
LIVE_SIMULATION=auto
# true = skip Open-Meteo: no forecast tabs, and ET₀ is estimated with FAO-56 Hargreaves.
OPEN_METEO_DISABLED=false
# Open-Meteo address (e.g. a self-hosted instance).
OPEN_METEO_BASE_URL=https://api.open-meteo.com
